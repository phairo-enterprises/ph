--- /dev/null
+++ b/openpilot/selfdrive/ui/installer/git_progress.h
@@ -0,0 +1,90 @@
+#pragma once
+#include <cerrno>
+#include <chrono>
+#include <deque>
+#include <string>
+#include <poll.h>
+#include <unistd.h>
+
+namespace installer_progress {
+// Diagnostics are observations of child stdout/stderr, not proof of forward progress.
+struct Output {
+  static constexpr size_t record_limit = 1024, history_limit = 8;
+  int progress;
+  bool saw_output = false, output_closed = false, observation_failed = false;
+  std::string phase = "No phase reported", last_record;
+  std::deque<std::string> history;
+  explicit Output(int initial = 0) : progress(initial) {}
+  void feed(const char *data, size_t size) {
+    if (size) saw_output = true;
+    for (size_t i = 0; i < size; ++i) {
+      unsigned char c = data[i];
+      if (c == '\r' || c == '\n') { record(); continue; }
+      if (pending.size() < record_limit) pending += (c >= 32 && c <= 126) ? char(c) : '?';
+      else truncated = true;
+    }
+  }
+  void finish() { record(); }
+private:
+  std::string pending;
+  bool truncated = false;
+  void record() {
+    if (pending.empty()) return;
+    if (!truncated) {
+      const char *labels[] = {"Receiving objects", "Resolving deltas", "Updating files"};
+      const int weights[] = {91, 2, 7};
+      int base = 0;
+      for (int i = 0; i < 3; ++i) {
+        const std::string prefix = std::string(labels[i]) + ": ";
+        if (pending.compare(0, prefix.size(), prefix) == 0) {
+          size_t at = prefix.size();
+          while (at < pending.size() && pending[at] == ' ') ++at;
+          size_t first = at; int percent = 0;
+          while (at < pending.size() && pending[at] >= '0' && pending[at] <= '9' && at-first < 3) percent = percent*10 + pending[at++]-'0';
+          if (at > first && at < pending.size() && pending[at] == '%' && percent <= 100) {
+            progress = base + percent * weights[i] / 100;
+            phase = labels[i];
+          }
+          break;
+        }
+        base += weights[i];
+      }
+    }
+    last_record = pending + (truncated ? " [truncated]" : "");
+    history.push_back(last_record);
+    if (history.size() > history_limit) history.pop_front();
+    pending.clear(); truncated = false;
+  }
+};
+
+// Single reader; read is only entered after poll reports readiness. No timeout kills.
+// Return 0 for EOF, -1 for observation error. Caller still owns pclose/child status.
+template <typename Draw>
+int pump(int fd, Output &output, Draw draw) {
+  if (fd < 0) { errno = EBADF; return -1; }
+  using Clock = std::chrono::steady_clock;
+  auto last_output = Clock::now(), last_draw = last_output;
+  draw(output, 0);
+  for (;;) {
+    pollfd watched{fd, POLLIN, 0};
+    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now()-last_draw).count();
+    const int timeout = elapsed >= 250 ? 0 : int(250-elapsed);
+    int ready = poll(&watched, 1, timeout);
+    if (ready < 0 && errno != EINTR) return -1;
+    if (ready > 0) {
+      if (watched.revents & POLLNVAL) { errno = EBADF; return -1; }
+      if (watched.revents & (POLLIN | POLLHUP)) {
+        char data[4096];
+        ssize_t n = read(fd, data, sizeof(data));
+        if (n > 0) { output.feed(data, size_t(n)); last_output = Clock::now(); }
+        else if (n == 0) { output.output_closed = true; output.finish(); draw(output, std::chrono::duration_cast<std::chrono::seconds>(Clock::now()-last_output).count()); return 0; }
+        else if (errno != EINTR && errno != EAGAIN) return -1;
+      } else if (watched.revents & POLLERR) { errno = EIO; return -1; }
+    }
+    auto now = Clock::now();
+    if (now-last_draw >= std::chrono::milliseconds(250)) {
+      draw(output, std::chrono::duration_cast<std::chrono::seconds>(now-last_output).count()); last_draw = now;
+    }
+  }
+}
+} // namespace installer_progress
